<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>profile</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="profile-hero">
    <div class="profile-text">
        <h1 id="username"><%= name %></h1>
        <p id="bio">Game developer creating experimental indie games.</p>
    </div>

    <div class="profile-avatar">
        <img id="avatar" src="https://plus.unsplash.com/premium_vector-1719858611039-66c134efa74d?q=80&w=880&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="avatar">
    </div>
</div>
</body>
</html>